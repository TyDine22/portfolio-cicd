---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Ty Dine about software development, DevOps, cloud infrastructure or AI projects."
>

  <section class="site-shell contact-page">

    <div class="contact-heading">

      <div>

        <p class="eyebrow">
          CONTACT
        </p>

        <h1>
          Have an idea?
          <span>Let's talk.</span>
        </h1>

      </div>

      <div class="contact-intro">

        <p>
          Whether it's a software project, cloud infrastructure,
          DevOps workflow or AI application, feel free to reach out.
        </p>

        <p>
          I'm always interested in learning about interesting
          technical problems and opportunities to collaborate.
        </p>

      </div>

    </div>


    <div class="contact-content">

      <!-- DETAILS -->

      <aside class="contact-details">

        <div class="detail-group">

          <span class="detail-label">
            EMAIL
          </span>

          <a href="mailto:tydined2@gmail.com">
            tydined2@gmail.com
          </a>

        </div>


        <div class="detail-group">

          <span class="detail-label">
            LOCATION
          </span>

          <p>
            Cambodia
          </p>

        </div>


        <div class="detail-group">

          <span class="detail-label">
            SOCIAL
          </span>

          <div class="social-links">

            <a
              href="https://github.com/TyDine22"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>

            <a
              href="https://linkedin.com/in/ty-dine-b8b143435"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn ↗
            </a>

          </div>

        </div>

      </aside>


      <!-- FORM -->

        <form
          class="contact-form"
          id="contact-form"
        >
        <div
          class="honeypot"
          aria-hidden="true"
        >
          <label for="website">
            Website
          </label>

          <input
            id="website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="field-row">

          <div class="form-field">

            <label for="name">
              Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your name"
              required
            />

          </div>


          <div class="form-field">

            <label for="email">
              Email
            </label>

            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />

          </div>

        </div>


        <div class="form-field">

          <label for="subject">
            Subject
          </label>

          <input
            id="subject"
            name="subject"
            type="text"
            placeholder="What would you like to discuss?"
            required
          />

        </div>


        <div class="form-field">

          <label for="message">
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="7"
            placeholder="Tell me a little about your project or idea..."
            required
          ></textarea>

        </div>


        <div class="form-footer">

          <p class="form-note">
            I'll only use your information to respond to your message.
          </p>

          <button
            type="submit"
            class="submit-button"
          >
            Send message
            <span>↗</span>
          </button>

        </div>


        <p
          id="form-status"
          class="form-status"
          aria-live="polite"
        ></p>

      </form>

    </div>

  </section>

</BaseLayout>


<script>
  const form =
    document.querySelector("#contact-form");

  const status =
    document.querySelector("#form-status");


  if (
    form instanceof HTMLFormElement &&
    status instanceof HTMLElement
  ) {

    form.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        /*
         * Browser validation first.
         */
        if (!form.checkValidity()) {

          form.reportValidity();

          return;

        }


        const submitButton =
          form.querySelector(
            'button[type="submit"]'
          );


        if (
          !(submitButton instanceof HTMLButtonElement)
        ) {
          return;
        }


        /*
         * Build request data.
         */
        const formData =
          new FormData(form);


        const data = {
          name:
            formData.get("name"),

          email:
            formData.get("email"),

          subject:
            formData.get("subject"),

          message:
            formData.get("message"),

          website:
            formData.get("website") ?? "",
        };


        /*
         * Loading state.
         */
        submitButton.disabled = true;

        submitButton.textContent =
          "Sending...";

        status.textContent = "";

        status.dataset.state =
          "loading";


        try {

          const response =
            await fetch(
              "/api/contact",
              {
                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json",
                },

                body:
                  JSON.stringify(data),
              }
            );


          const result =
            await response.json();


          /*
           * Server rejected submission.
           */
          if (!response.ok) {

            status.textContent =
              result.message ??
              "Something went wrong.";

            status.dataset.state =
              "error";

            return;

          }


          /*
           * Success
           */
          status.textContent =
            result.message;

          status.dataset.state =
            "success";


          /*
           * Clear fields after successful
           * validation.
           */
          form.reset();


        } catch (error) {

          console.error(error);

          status.textContent =
            "Unable to send the message. Please try again.";

          status.dataset.state =
            "error";


        } finally {

          submitButton.disabled =
            false;

          submitButton.innerHTML =
            "Send message <span>↗</span>";

        }

      }
    );

  }
</script>


<style>

  .contact-page {
    padding-block:
      clamp(90px, 11vw, 150px);
  }

  .honeypot {
    position: absolute;

    width: 1px;
    height: 1px;

    overflow: hidden;

    clip:
      rect(0 0 0 0);

    clip-path:
      inset(50%);

    white-space:
      nowrap;
  }


  /* HEADING */

  .contact-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(280px, 0.65fr);

    align-items: end;

    gap:
      clamp(50px, 9vw, 120px);

    padding-bottom:
      clamp(70px, 9vw, 110px);

    border-bottom:
      1px solid
      var(--color-line);
  }

  .eyebrow {
    margin:
      0
      0
      24px;

    color:
      var(--color-red);

    font-family:
      var(--font-mono);

    font-size:
      11px;

    font-weight:
      700;

    letter-spacing:
      0.16em;
  }

  h1 {
    max-width: 780px;

    margin: 0;

    font-family:
      var(--font-display);

    font-size:
      clamp(3.7rem, 7vw, 7rem);

    font-weight:
      600;

    line-height: 0.92;

    letter-spacing:
      -0.05em;
  }

  h1 span {
    color:
      var(--color-red);
  }

  .contact-intro {
    color:
      var(--color-ink-soft);

    line-height: 1.8;
  }

  .contact-intro p {
    margin:
      0
      0
      20px;
  }


  /* MAIN CONTENT */

  .contact-content {
    display: grid;

    grid-template-columns:
      260px
      minmax(0, 1fr);

    gap:
      clamp(50px, 8vw, 100px);

    padding-top:
      clamp(70px, 9vw, 110px);
  }


  /* CONTACT DETAILS */

  .contact-details {
    display: flex;

    flex-direction: column;

    gap: 44px;
  }

  .detail-label {
    display: block;

    margin-bottom: 10px;

    color:
      var(--color-ink-faint);

    font-family:
      var(--font-mono);

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      0.13em;
  }

  .detail-group p {
    margin: 0;

    font-size: 14px;
  }

  .detail-group > a {
    font-size: 14px;

    border-bottom:
      1px solid
      var(--color-line);
  }

  .detail-group > a:hover {
    color:
      var(--color-red);

    border-color:
      var(--color-red);
  }

  .social-links {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 8px;
  }

  .social-links a {
    font-family:
      var(--font-mono);

    font-size: 11px;
  }

  .social-links a:hover {
    color:
      var(--color-red);
  }


  /* FORM */

  .contact-form {
    max-width: 780px;
  }

  .field-row {
    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 24px;
  }

  .form-field {
    margin-bottom: 30px;
  }

  .form-field label {
    display: block;

    margin-bottom: 10px;

    font-family:
      var(--font-mono);

    font-size: 10px;

    font-weight: 700;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;

    padding:
      15px
      0;

    background:
      transparent;

    border: 0;

    border-bottom:
      1px solid
      var(--color-line);

    border-radius: 0;

    color:
      var(--color-ink);

    outline: none;

    transition:
      border-color
      150ms ease;
  }

  .form-field textarea {
    resize: vertical;

    min-height: 170px;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color:
      var(--color-ink-faint);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color:
      var(--color-red);
  }


  /* FOOTER */

  .form-footer {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 30px;

    margin-top: 15px;
  }

  .form-note {
    max-width: 360px;

    margin: 0;

    color:
      var(--color-ink-faint);

    font-size: 12px;

    line-height: 1.6;
  }

  .submit-button {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding:
      14px
      20px;

    background:
      var(--color-ink);

    border:
      1px solid
      var(--color-ink);

    color:
      var(--color-paper);

    cursor: pointer;

    font-family:
      var(--font-mono);

    font-size: 11px;

    font-weight: 700;

    transition:
      background
      150ms ease,
      border-color
      150ms ease,
      transform
      150ms ease;
  }

  .submit-button:hover {
    background:
      var(--color-red);

    border-color:
      var(--color-red);

    transform:
      translateY(-2px);
  }

  .form-status {
  min-height: 24px;

  margin:
    22px
    0
    0;

  font-size: 13px;
}

.form-status[data-state="success"] {
  color:
    #237a45;
}

.form-status[data-state="error"] {
  color:
    var(--color-red);
}

.submit-button:disabled {
  cursor:
    not-allowed;

  opacity: 0.6;

  transform: none;
}


  /* RESPONSIVE */

  @media (max-width: 800px) {

    .contact-heading {
      grid-template-columns:
        1fr;
    }

    .contact-intro {
      max-width: 600px;
    }

    .contact-content {
      grid-template-columns:
        1fr;
    }

    .contact-details {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 30px;

      padding-bottom: 50px;

      border-bottom:
        1px solid
        var(--color-line);
    }

  }


  @media (max-width: 600px) {

    .field-row {
      grid-template-columns:
        1fr;
    }

    .contact-details {
      grid-template-columns:
        1fr;
    }

    .form-footer {
      align-items:
        flex-start;

      flex-direction:
        column;
    }

  }

</style>