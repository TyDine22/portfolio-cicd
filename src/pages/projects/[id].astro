---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      id: project.id,
    },

    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
>

  <article>

    <!-- PROJECT HERO -->

    <header class="site-shell project-header">

      <a
        href="/projects"
        class="back-link"
      >
        ← All projects
      </a>

      <div class="project-heading">

        <div>

          <p class="project-category">
            {project.data.category}
            <span>/</span>
            {project.data.year}
          </p>

          <h1>
            {project.data.title}
          </h1>

        </div>

        <p class="project-description">
          {project.data.description}
        </p>

      </div>


      <!-- TECHNOLOGIES -->

      <div class="technologies">

        {
          project.data.technologies.map((technology) => (
            <span>
              {technology}
            </span>
          ))
        }

      </div>


      <!-- PROJECT LINKS -->

      {
        (project.data.github || project.data.demo) && (

          <div class="project-links">

            {
              project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub ↗
                </a>
              )
            }

            {
              project.data.demo && (
                <a
                  href={project.data.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live project ↗
                </a>
              )
            }

          </div>

        )
      }

    </header>


    <!-- HERO VISUAL -->

    <section class="site-shell visual-section">

      {
        project.data.hero ? (

          <div class="hero-image">

            <Image
              src={project.data.hero}
              alt={
                project.data.heroAlt ??
                project.data.title
              }
              layout="full-width"
              priority
            />

          </div>

        ) : (

          <div class="project-placeholder">

            <span>
              {String(project.data.order).padStart(2, "0")}
            </span>

            <p>
              {project.data.category}
            </p>

            <strong>
              {project.data.title}
            </strong>

          </div>

        )
      }

    </section>


    <!-- PROJECT METADATA -->

    <section class="project-meta">

      <div class="site-shell meta-grid">

        <div class="meta-item">

          <span>
            CATEGORY
          </span>

          <strong>
            {project.data.category}
          </strong>

        </div>

        <div class="meta-item">

          <span>
            YEAR
          </span>

          <strong>
            {project.data.year}
          </strong>

        </div>

        <div class="meta-item">

          <span>
            STACK
          </span>

          <strong>
            {project.data.technologies.length}
            {" "}
            technologies
          </strong>

        </div>

      </div>

    </section>


    <!-- MARKDOWN CASE STUDY -->

    <section class="site-shell content-wrapper">

      <aside class="content-label">

        <span>
          CASE STUDY
        </span>

      </aside>

      <div class="project-content">

        <Content />

      </div>

    </section>


    <!-- NEXT ACTION -->

    <section class="site-shell bottom-navigation">

      <a href="/projects">

        <span>
          EXPLORE MORE
        </span>

        <strong>
          All projects →
        </strong>

      </a>

    </section>

  </article>

</BaseLayout>


<style>

  /* HEADER */

  .project-header {
    padding-top:
      clamp(
        70px,
        9vw,
        120px
      );

    padding-bottom:
      clamp(
        60px,
        8vw,
        100px
      );
  }

  .back-link {
    display: inline-block;

    margin-bottom: 80px;

    color: var(--color-ink-soft);

    font-family: var(--font-mono);

    font-size: 11px;
  }

  .back-link:hover {
    color: var(--color-red);
  }

  .project-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(260px, 0.6fr);

    align-items: end;

    gap:
      clamp(
        40px,
        8vw,
        100px
      );
  }

  .project-category {
    display: flex;

    gap: 8px;

    margin:
      0
      0
      22px;

    color: var(--color-red);

    font-family: var(--font-mono);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.12em;
  }

  h1 {
    max-width: 820px;

    margin: 0;

    font-family: var(--font-display);

    font-size:
      clamp(
        3.5rem,
        8vw,
        7.5rem
      );

    font-weight: 600;

    line-height: 0.9;

    letter-spacing: -0.05em;
  }

  .project-description {
    margin: 0;

    color: var(--color-ink-soft);

    font-size: 1rem;

    line-height: 1.8;
  }


  /* TECHNOLOGY TAGS */

  .technologies {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 48px;
  }

  .technologies span {
    padding:
      7px
      10px;

    background: var(--color-card);

    border:
      1px solid
      var(--color-line);

    font-family: var(--font-mono);

    font-size: 10px;
  }


  /* PROJECT LINKS */

  .project-links {
    display: flex;

    gap: 14px;

    margin-top: 28px;
  }

  .project-links a {
    padding:
      10px
      14px;

    border:
      1px solid
      var(--color-ink);

    font-family: var(--font-mono);

    font-size: 10px;

    font-weight: 600;
  }

  .project-links a:hover {
    background: var(--color-ink);

    color: var(--color-paper);
  }


  /* HERO VISUAL */

  .visual-section {
    padding-bottom:
      clamp(
        70px,
        9vw,
        120px
      );
  }

  .hero-image {
    overflow: hidden;

    border:
      1px solid
      var(--color-line);

    background:
      var(--color-card);
  }

  .hero-image :global(img) {
    width: 100%;

    max-height: 680px;

    object-fit: cover;
  }


  /* PLACEHOLDER */

  .project-placeholder {
    position: relative;

    min-height:
      clamp(
        360px,
        55vw,
        620px
      );

    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    padding:
      clamp(
        30px,
        6vw,
        70px
      );

    overflow: hidden;

    background: var(--color-dark);

    color: var(--color-paper);
  }

  .project-placeholder::before {
    content: "";

    position: absolute;

    width: 420px;
    height: 420px;

    right: -80px;
    top: -100px;

    border:
      1px solid
      #463b36;

    border-radius: 50%;
  }

  .project-placeholder::after {
    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    right: 30px;
    top: 20px;

    border:
      1px solid
      var(--color-red);

    border-radius: 50%;
  }

  .project-placeholder > span {
    position: absolute;

    top: 42px;
    left: 48px;

    color: var(--color-red);

    font-family: var(--font-mono);

    font-size: 12px;

    font-weight: 700;
  }

  .project-placeholder p {
    position: relative;

    z-index: 2;

    margin:
      0
      0
      14px;

    color: #aaa09a;

    font-family: var(--font-mono);

    font-size: 10px;

    letter-spacing: 0.14em;

    text-transform: uppercase;
  }

  .project-placeholder strong {
    position: relative;

    z-index: 2;

    max-width: 750px;

    font-family: var(--font-display);

    font-size:
      clamp(
        3rem,
        7vw,
        7rem
      );

    font-weight: 600;

    line-height: 0.95;
  }


  /* METADATA */

  .project-meta {
    border-top:
      1px solid
      var(--color-line);

    border-bottom:
      1px solid
      var(--color-line);
  }

  .meta-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);
  }

  .meta-item {
    padding:
      28px
      32px;

    border-right:
      1px solid
      var(--color-line);
  }

  .meta-item:first-child {
    padding-left: 0;
  }

  .meta-item:last-child {
    border-right: 0;
  }

  .meta-item span {
    display: block;

    margin-bottom: 7px;

    color: var(--color-ink-faint);

    font-family: var(--font-mono);

    font-size: 9px;

    letter-spacing: 0.12em;
  }

  .meta-item strong {
    font-size: 13px;

    font-weight: 600;
  }


  /* CONTENT */

  .content-wrapper {
    display: grid;

    grid-template-columns:
      180px
      minmax(0, 760px);

    gap: 60px;

    padding-top:
      clamp(
        90px,
        12vw,
        150px
      );

    padding-bottom:
      clamp(
        100px,
        14vw,
        180px
      );
  }

  .content-label {
    padding-top: 12px;
  }

  .content-label span {
    color: var(--color-red);

    font-family: var(--font-mono);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 0.14em;
  }

  .project-content {
    max-width: 760px;
  }

  .project-content :global(h2) {
    margin:
      80px
      0
      26px;

    font-family: var(--font-display);

    font-size:
      clamp(
        2.3rem,
        5vw,
        3.8rem
      );

    font-weight: 600;

    line-height: 1;

    letter-spacing: -0.03em;
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
  }

  .project-content :global(h3) {
    margin:
      50px
      0
      20px;

    font-family: var(--font-display);

    font-size: 1.8rem;

    font-weight: 600;
  }

  .project-content :global(p) {
    margin:
      0
      0
      25px;

    color: var(--color-ink-soft);

    font-size: 1.02rem;

    line-height: 1.9;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin:
      28px
      0;

    padding-left: 24px;

    color: var(--color-ink-soft);
  }

  .project-content :global(li) {
    margin-bottom: 12px;

    padding-left: 6px;

    line-height: 1.7;
  }

  .project-content :global(strong) {
    color: var(--color-ink);
  }


  /* BOTTOM NAV */

  .bottom-navigation {
    padding-bottom:
      clamp(
        100px,
        12vw,
        150px
      );
  }

  .bottom-navigation a {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    padding:
      34px
      0;

    border-top:
      1px solid
      var(--color-line);

    border-bottom:
      1px solid
      var(--color-line);
  }

  .bottom-navigation span {
    color: var(--color-red);

    font-family: var(--font-mono);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 0.14em;
  }

  .bottom-navigation strong {
    font-family: var(--font-display);

    font-size:
      clamp(
        1.8rem,
        4vw,
        3rem
      );

    font-weight: 600;
  }

  .bottom-navigation a:hover strong {
    color: var(--color-red);
  }


  /* RESPONSIVE */

  @media (max-width: 800px) {

    .project-heading {
      grid-template-columns: 1fr;
    }

    .project-description {
      max-width: 600px;
    }

    .content-wrapper {
      grid-template-columns: 1fr;

      gap: 30px;
    }

    .meta-grid {
      grid-template-columns: 1fr;
    }

    .meta-item {
      padding:
        20px
        0;

      border-right: 0;

      border-bottom:
        1px solid
        var(--color-line);
    }

    .meta-item:last-child {
      border-bottom: 0;
    }

  }

</style>