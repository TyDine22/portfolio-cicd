---
interface Props {
  number: string;
  label: string;
  title: string;
  description?: string;
}

const {
  number,
  label,
  title,
  description,
} = Astro.props;
---

<div class="section-heading">

  <div class="section-meta">
    <span>{number}</span>
    <span>/</span>
    <span>{label}</span>
  </div>

  <div class="section-title-wrapper">

    <h2>{title}</h2>

    {
      description && (
        <p>
          {description}
        </p>
      )
    }

  </div>

</div>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: 180px 1fr;

    gap: 40px;

    margin-bottom: 56px;
  }

  .section-meta {
    display: flex;
    gap: 8px;

    padding-top: 12px;

    color: var(--color-red);

    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.12em;
  }

  .section-title-wrapper {
    max-width: 760px;
  }

  h2 {
    margin: 0;

    font-family: var(--font-display);

    font-size: clamp(
      2.5rem,
      5vw,
      4.5rem
    );

    font-weight: 600;

    line-height: 1;

    letter-spacing: -0.035em;
  }

  p {
    max-width: 620px;

    margin: 20px 0 0;

    color: var(--color-ink-soft);

    font-size: 1rem;

    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .section-heading {
      grid-template-columns: 1fr;

      gap: 16px;
    }

    .section-meta {
      padding-top: 0;
    }
  }
</style>